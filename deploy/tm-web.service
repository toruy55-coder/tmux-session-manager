[Unit]
Description=tm-web (tmuxセッション一覧ダッシュボード)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mtb-linux/github/tmux-session-manager
Environment=TM_WEB_HOST=100.74.222.40
Environment=TM_WEB_PORT=8765
Environment=TM_WEB_SSH_USER=mtb-linux
Environment=TM_WEB_SSH_HOST=mtb-linux
ExecStart=/usr/bin/python3 /home/mtb-linux/github/tmux-session-manager/web.py

Restart=on-failure
RestartSec=5
StandardOutput=append:/home/mtb-linux/github/tmux-session-manager/web.log
StandardError=append:/home/mtb-linux/github/tmux-session-manager/web.log

[Install]
WantedBy=default.target
